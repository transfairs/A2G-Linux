# SPDX-License-Identifier: GPL-3.0-only
# install.sh fills in the @...@ values and keeps the blocks "# @BEGIN <tags>" ... "# @END" of its variant
# (CD: 1999 CD, GOG: GOG installer, DVD: 2007 CD on the "ANSTOSS 2007" DVD) and, if it could fetch
# A2G-Icon's icon, those of ICONREPO
name: @NAME@
game_slug: @SLUG@
slug: @SLUG@
version: @VERSION@
runner: wine

script:
  game:
    # 640x480 Wine virtual desktop (Proton ignores the registry setting for it), inside it
    # a2start.exe: switches to 640x480x16 and patches the game in memory (see README)
    exe: $GAMEDIR/drive_c/windows/explorer.exe
    working_dir: $GAMEDIR/drive_c/Spiele/Anstoss 2 Gold
    args: /desktop=A2,640x480 "C:/Spiele/Anstoss 2 Gold/a2start.exe" @EXE@ /f
    prefix: $GAMEDIR

  wine:
    # Fixed Proton version (tested with it); with "GE-Proton (Latest)", umu would fetch every new release.
    # Without "-x86_64": Lutris drops it from GE-Proton names anyway (install.sh links the folder).
    version: GE-Proton11-12
    dxvk: false
    vkd3d: false
    overrides:
      ddraw: builtin
      dsound: builtin

  system:
    env:
      # GNOME 50: GTK3 inside Gamescope crashes (key "antialiasing" missing), hence a patched schema copy
      GSETTINGS_SCHEMA_DIR: $GAMEDIR/gschemas
      # gsfix.so (Gamescope only): keep clicks on the window frame away from the game, set the
      # window title and disable Proton's Gamescope hack that strips title bars from dialogs;
      # the app ID links the window to Lutris' menu entry (name and icon in the dock)
      LD_PRELOAD: $GAMEDIR/gsfix.so
      GSFIX_TITLE: Anstoss 2 Gold
      GSFIX_APPID: net.lutris.@SLUG@-[0-9]*
      GSFIX_WMNAME: gamescope
    gamescope: true
    gamescope_game_res: 640x480
    gamescope_output_res: 1280x960
    gamescope_window_mode: ""
    gamescope_flags: "-S fit -F pixel"

  installer:
    - task:
        name: create_prefix
        prefix: $GAMEDIR

    - execute:
        command: '"@PKG@/install.sh" --make-schemas "$GAMEDIR/gschemas"'
        disable_runtime: true  # glib-compile-schemas with the system's libraries
# @BEGIN CD DVD

    # Mount the converted CD copy as CD-ROM drive D: (2007 CD: the folder CD in the game folder, as
    # Kalypso's setup installs it). If the CD or ISO was mounted while the prefix was created, Wine
    # has taken D: for it (d: and the device link d::); without removing d::, Wine points D: back to
    # the original CD with its Indeo videos on the next start (MCI error).
    - execute:
        command: 'rm -f "$GAMEDIR/dosdevices/d:" "$GAMEDIR/dosdevices/d::" && ln -s "@CDCOPY@" "$GAMEDIR/dosdevices/d:"'
    - task:
        name: set_regedit
        prefix: $GAMEDIR
        path: HKEY_LOCAL_MACHINE\Software\Wine\Drives
        key: "d:"
        value: cdrom
        type: REG_SZ
# @END

    # 96 DPI, no font smoothing
    - task:
        name: set_regedit
        prefix: $GAMEDIR
        path: HKEY_CURRENT_USER\Control Panel\Desktop
        key: LogPixels
        value: "00000060"
        type: REG_DWORD
    - task:
        name: set_regedit
        prefix: $GAMEDIR
        path: HKEY_CURRENT_USER\Control Panel\Desktop
        key: FontSmoothing
        value: "0"
        type: REG_SZ

    # Title bars in the colors of the XP theme Royale Noir (white on slate blue, inactive gray blue)
    - task:
        name: set_regedit
        prefix: $GAMEDIR
        path: HKEY_CURRENT_USER\Control Panel\Colors
        key: ActiveTitle
        value: "41 56 74"
        type: REG_SZ
    - task:
        name: set_regedit
        prefix: $GAMEDIR
        path: HKEY_CURRENT_USER\Control Panel\Colors
        key: GradientActiveTitle
        value: "58 70 86"
        type: REG_SZ
    - task:
        name: set_regedit
        prefix: $GAMEDIR
        path: HKEY_CURRENT_USER\Control Panel\Colors
        key: TitleText
        value: "255 255 255"
        type: REG_SZ
    - task:
        name: set_regedit
        prefix: $GAMEDIR
        path: HKEY_CURRENT_USER\Control Panel\Colors
        key: InactiveTitle
        value: "86 94 106"
        type: REG_SZ
    - task:
        name: set_regedit
        prefix: $GAMEDIR
        path: HKEY_CURRENT_USER\Control Panel\Colors
        key: GradientInactiveTitle
        value: "106 114 126"
        type: REG_SZ
    - task:
        name: set_regedit
        prefix: $GAMEDIR
        path: HKEY_CURRENT_USER\Control Panel\Colors
        key: InactiveTitleText
        value: "196 200 208"
        type: REG_SZ
    # Background of the virtual desktop in the active title bar color
    - task:
        name: set_regedit
        prefix: $GAMEDIR
        path: HKEY_CURRENT_USER\Control Panel\Colors
        key: Background
        value: "41 56 74"
        type: REG_SZ
    # On it, centred, the icon from A2G-Icon or the one picked (the question ICON below; src/a2assets.py
    # writes a2desktop.bmp only for those, not for the game's own icon; without the file Wine shows
    # the plain color)
    - task:
        name: set_regedit
        prefix: $GAMEDIR
        path: HKEY_CURRENT_USER\Control Panel\Desktop
        key: Wallpaper
        value: 'C:\\Spiele\\Anstoss 2 Gold\\a2desktop.bmp'
        type: REG_SZ
    - task:
        name: set_regedit
        prefix: $GAMEDIR
        path: HKEY_CURRENT_USER\Control Panel\Desktop
        key: TileWallpaper
        value: "0"
        type: REG_SZ

    # Bold title bar font as in Royale Noir (LOGFONTW: Tahoma, height 10, weight 700)
    - task:
        name: set_regedit
        prefix: $GAMEDIR
        path: HKEY_CURRENT_USER\Control Panel\Desktop\WindowMetrics
        key: CaptionFont
        value: "0a 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 bc 02 00 00 00 00 00 01 00 00 00 00 54 00 61 00 68 00 6f 00 6d 00 61 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00"
        type: REG_BINARY

    # DirectDraw via GDI instead of OpenGL (video windows get painted over otherwise)
    - task:
        name: set_regedit
        prefix: $GAMEDIR
        path: HKEY_CURRENT_USER\Software\Wine\Direct3D
        key: renderer
        value: gdi
        type: REG_SZ

    # Without this, the game stops reacting to input after another window is clicked
    - task:
        name: set_regedit
        prefix: $GAMEDIR
        path: HKEY_CURRENT_USER\Software\Wine\X11 Driver
        key: UseTakeFocus
        value: "N"
        type: REG_SZ

# @BEGIN CD
    # Original setup, silent, to C:\Spiele\Anstoss 2 Gold (response file a2setup.iss on the CD copy,
    # written by install.sh; result in a2setup.log). a2setup.exe closes the Start menu folder window
    # the setup opens at the end; it would keep the installation waiting. Backslashes doubled for Lutris.
    - task:
        name: wineexec
        prefix: $GAMEDIR
        executable: '@PKG@/src/a2setup.exe'
        args: 'D:\\@SETUP@ -s -f1D:\\a2setup.iss -f2D:\\a2setup.log'

    - execute:
        command: 'grep -q "^ResultCode=0" "@CDCOPY@/a2setup.log" && test -f "$GAMEDIR/drive_c/Spiele/Anstoss 2 Gold/anstoss2.exe" || { echo "The setup failed, see @CDCOPY@/a2setup.log"; exit 1; }'
# @END
# @BEGIN GOG
    # GOG installer: unpacked with innoextract instead of running it. GOG ships the 2007 CD release
    # (run.exe, unpacked from its copy protection) plus its own additions; only the game itself goes
    # to C:\Spiele\Anstoss 2 Gold. Left out or removed: DirectX, GOG's DirectDraw wrapper ddraw.dll
    # (Gamescope scales the game here), the compatibility database game.sdb, the goggame-* files
    # and the installer's own files. Kept: rest.sav (GOG puts it under __support/save; without it a
    # new game crashes) and ExSpiel.sav (app/DATA.DEF, app/DATA.VER).
    - execute:
        command: 'mkdir -p "$GAMEDIR/drive_c/Spiele/Anstoss 2 Gold" && "@INNOEXTRACT@" -s -m -g -d "$GAMEDIR/drive_c/Spiele/Anstoss 2 Gold" "@SETUP@" && cd "$GAMEDIR/drive_c/Spiele/Anstoss 2 Gold" && cp __support/save/* . && cp -r app/DATA.DEF app/DATA.VER . && rm -rf __redist __support app commonappdata ddraw.dll game.sdb goggame-* && test -f run.exe && test -f rest.sav || { echo "Unpacking @SETUP@ failed"; exit 1; }'
        disable_runtime: true  # a system innoextract needs the system's libraries

    # What the GOG installer writes to the registry; the game reads its folder from InstalledTo
    # (32-bit program, hence Wow6432Node)
    - task:
        name: set_regedit
        prefix: $GAMEDIR
        path: HKEY_LOCAL_MACHINE\Software\Wow6432Node\ASCARON\ANSTOSS 2\1.00
        key: InstalledTo
        value: 'C:\\Spiele\\Anstoss 2 Gold'
        type: REG_SZ
    - task:
        name: set_regedit
        prefix: $GAMEDIR
        path: HKEY_LOCAL_MACHINE\Software\Wow6432Node\ASCARON\ANSTOSS 2\1.00
        key: InstalledFrom
        value: 'C:\\Spiele\\Anstoss 2 Gold'
        type: REG_SZ
    - task:
        name: set_regedit
        prefix: $GAMEDIR
        path: HKEY_LOCAL_MACHINE\Software\Wow6432Node\ASCARON\ANSTOSS 2\1.00
        key: Language
        value: DEU
        type: REG_SZ
# @END
# @BEGIN DVD
    # 2007 CD: ANSTOSS_2_GOLD/Setup.exe (Inno Setup) on the DVD, unpacked with innoextract instead of
    # running it. Its files go to C:\Spiele\Anstoss 2 Gold as Kalypso's setup installs them, with the
    # folder CD (the CD's ARCHIVES, SOUNDS and VIDEOS), which becomes drive D: (see above). The
    # launcher anstoss2.exe and its compatibility.dll stay unused. run.exe is taken out of its
    # PECRYPT32 shell (src/a2unpack.py; original kept as run.exe.vor-entpacken).
    - execute:
        command: 'S="$GAMEDIR/drive_c/Spiele" && mkdir -p "$S" && rm -rf "$S/a2inno" && "@INNOEXTRACT@" -s -m -d "$S/a2inno" "@SETUP@" && mv "$S/a2inno/app" "$S/Anstoss 2 Gold" && rm -rf "$S/a2inno" && python3 "@PKG@/src/a2unpack.py" "$S/Anstoss 2 Gold/run.exe" || { echo "Unpacking @SETUP@ failed"; exit 1; }'
        disable_runtime: true  # a system innoextract needs the system's libraries

    # What the 1999 setup writes to the registry; the game reads its folder from InstalledTo
    # (32-bit program, hence Wow6432Node)
    - task:
        name: set_regedit
        prefix: $GAMEDIR
        path: HKEY_LOCAL_MACHINE\Software\Wow6432Node\ASCARON\ANSTOSS 2\1.00
        key: InstalledTo
        value: 'C:\\Spiele\\Anstoss 2 Gold'
        type: REG_SZ
    - task:
        name: set_regedit
        prefix: $GAMEDIR
        path: HKEY_LOCAL_MACHINE\Software\Wow6432Node\ASCARON\ANSTOSS 2\1.00
        key: InstalledFrom
        value: 'D:\\'
        type: REG_SZ
    - task:
        name: set_regedit
        prefix: $GAMEDIR
        path: HKEY_LOCAL_MACHINE\Software\Wow6432Node\ASCARON\ANSTOSS 2\1.00
        key: Language
        value: DEU
        type: REG_SZ
# @END

    - execute:
        command: 'cp "@PKG@/src/a2start.exe" "$GAMEDIR/drive_c/Spiele/Anstoss 2 Gold/" && cp "@PKG@/src/gsfix.so" "$GAMEDIR/"'

    # Bug fixes from A2G-Patch (--fixes, see README): sound on the default audio device, arrow buttons that
    # keep counting, undecodable videos skipped, no freeze after 24.9 days of uptime, no false disk space
    # warning, squads limited to 30 players, investment growth kept off the bank balance, the club's money
    # stopping at 2 billion DM instead of running over, random events that do what their message says,
    # no crash on events without a fitting player, referees with a grudge hitting the right club,
    # trainers and managers in weak countries improving yearly, appearances without a mark kept out of
    # the average, the grade chart labelled "Noten/6", a list of the most appearances that
    # takes new players after 50; and, although A2G-Patch counts them as balancing, fish poisoning that
    # keeps a player out for the three weeks its message says, all events around the manager's private
    # life (--fish, --manager), the lawn care button without a bar under Wine (--lawn, a fix of A2G-Linux)
    # and interview answers that take effect
    # (--interviews, a balancing patch in A2G-Patch, applied every time);
    # GOG and 2007 CD: also let the CD checks of the 2007 release pass (--disc-check) and add the program
    # changes of patch 1.01 (--v101, src/a2v101.S), see README
    - execute:
        command: 'python3 "@PKG@/src/a2patch.py" --fixes --interviews @FIXES@ "$GAMEDIR/drive_c/Spiele/Anstoss 2 Gold/@EXE@"'
        disable_runtime: true

    # Indeo videos in the game folder (GOG; 2007 CD: in its folder CD; on the 1999 CD version only if
    # the setup copied videos)
    - execute:
        command: '"@PKG@/install.sh" --convert-only "$GAMEDIR/drive_c/Spiele/Anstoss 2 Gold"'
        disable_runtime: true  # ffmpeg/ffprobe do not start with Lutris' runtime libraries

# @BEGIN GOG DVD
    # Data of patch 1.01: event texts, LAENDER.SAV, MoveList.dat (src/a2data101.py, src/a2movelist.py)
    - execute:
        command: 'python3 "@PKG@/src/a2data101.py" "$GAMEDIR/drive_c/Spiele/Anstoss 2 Gold"'
        disable_runtime: true

# @END
# @BEGIN GOG
    # Dialogs as in 1999: title bars, frames of the choices etc. in RESDLL.dll (src/a2resdll.py);
    # the RESDLL.dll of the 2007 CD has them already
    - execute:
        command: 'python3 "@PKG@/src/a2resdll.py" "$GAMEDIR/drive_c/Spiele/Anstoss 2 Gold"'
        disable_runtime: true

# @END
    # Icon for Lutris, the dock and the application menu (src/a2assets.py, install.sh keeps the game's
    # icon in build/anstoss2.ico). install.sh offers A2G-Icon only if it could fetch it; if it can't be
    # fetched now or no usable file is picked, the game's own icon is used.
    - input_menu:
        description: 'Welches Icon soll das Spiel in Lutris, im Dock und im Anwendungsmenü bekommen? Das Icon des Spiels hat nur 32×32 Pixel und 16 Farben und wirkt vergrößert pixelig. A2G-Icon ist eine Neuzeichnung davon. Ein neu gezeichnetes oder eigenes Icon erscheint auch in der Mitte des Spielhintergrunds.'
        id: ICON
        options:
          - game: Icon des Spiels
# @BEGIN ICONREPO
          - repo: Neu gezeichnetes Icon von A2G-Icon herunterladen
# @END
          - file: Eigene Dateien wählen (PNG und/oder SVG)
        preselect: game
    - execute:
        command: 'python3 "@PKG@/src/a2assets.py" icon "$INPUT_ICON" "@PKG@/build/anstoss2.ico" "@ICONS@" "lutris_@SLUG@" "$GAMEDIR/drive_c/Spiele/Anstoss 2 Gold/a2desktop.bmp"'
        disable_runtime: true  # ImageMagick and zenity with the system's libraries

    # Optional: data set (overwrites the game's files) and save games (existing ones are kept)
    - input_menu:
        description: 'Einen Anstoss-2-Datensatz in den Spielordner importieren?'
        id: DATASET
        options:
          - none: Nicht importieren
          - zip: Aus einer Zip-Datei
          - dir: Aus einem Ordner
        preselect: none
    - execute:
        command: 'python3 "@PKG@/src/a2import.py" --overwrite --title "Anstoss-2-Datensatz" "$INPUT_DATASET" "$GAMEDIR/drive_c/Spiele/Anstoss 2 Gold"'
        disable_runtime: true  # zenity does not start with Lutris' runtime libraries

    - input_menu:
        description: 'Spielstände in den Spielordner importieren?'
        id: SAVES
        options:
          - none: Nicht importieren
          - dir: Aus einem Ordner
          - zip: Aus einer Zip-Datei
        preselect: none
    - execute:
        command: 'python3 "@PKG@/src/a2import.py" --title "Anstoss-2-Spielstände" "$INPUT_SAVES" "$GAMEDIR/drive_c/Spiele/Anstoss 2 Gold"'
        disable_runtime: true  # zenity does not start with Lutris' runtime libraries

    # Optional balancing patches from A2G-Patch, one page each (see README)
    - input_menu:
        description: 'Verhandlungssperre monatlich abbauen? Nach drei Verhandlungsterminen mit Spielern eines Vereins gibt dieser keine Spieler mehr ab. Das Spiel will diese Sperre jeden Monat halbieren, erwischt wegen eines Fehlers aber die falschen Bytes, sodass sie bis zur nächsten Saison hält. Der Patch lässt sie wie vorgesehen abbauen.'
        id: NEGOTIATION
        options:
          - 'no': Original beibehalten
          - 'yes': Sperre monatlich abbauen
        preselect: 'no'
    - execute:
        command: 'test "$INPUT_NEGOTIATION" != yes || python3 "@PKG@/src/a2patch.py" --negotiation "$GAMEDIR/drive_c/Spiele/Anstoss 2 Gold/@EXE@"'
        disable_runtime: true

    - input_menu:
        description: 'Torgrenzen aufheben? Ohne Patch trifft eine Mannschaft vor der Halbzeit höchstens 6-mal und danach höchstens 10-mal, ab 7 Toren halbieren sich ihre Chancen. Der Patch hebt die Grenze auf 15 an.'
        id: GOALS
        options:
          - 'no': Original beibehalten
          - 'yes': Torgrenzen aufheben
        preselect: 'no'
    - execute:
        command: 'test "$INPUT_GOALS" != yes || python3 "@PKG@/src/a2patch.py" --goals "$GAMEDIR/drive_c/Spiele/Anstoss 2 Gold/@EXE@"'
        disable_runtime: true

    - input_menu:
        description: 'Unpassende Ansprachen bestrafen? Laut Spielhilfe kehrt sich die Wirkung einer Ansprache in der Mannschaftssitzung ins Negative um, wenn sie nicht zur Lage passt. Im Original zeigt das Spiel nur eine Meldung an. Mit dem Patch zieht eine unpassende Ansprache ihre Prozente für dieses Spiel von Abwehr und Angriff ab.'
        id: SPEECHES
        options:
          - 'no': Original beibehalten
          - 'yes': Unpassende Ansprachen bestrafen
        preselect: 'no'
    - execute:
        command: 'test "$INPUT_SPEECHES" != yes || python3 "@PKG@/src/a2patch.py" --speeches "$GAMEDIR/drive_c/Spiele/Anstoss 2 Gold/@EXE@"'
        disable_runtime: true

    - input_menu:
        description: 'Trainer-Nachwuchs verbessern? Im Original werden die Co- und Torwarttrainer, die die Vereine einstellen können, über die Jahre immer schwächer, bis kaum noch gute übrig sind. Mit dem Patch kommen immer wieder starke Trainer nach, darunter auch ehemalige Spieler.'
        id: COACHES
        options:
          - 'no': Original beibehalten
          - 'yes': Trainer-Nachwuchs verbessern
        preselect: 'no'
    - execute:
        command: 'test "$INPUT_COACHES" != yes || python3 "@PKG@/src/a2patch.py" --coaches "$GAMEDIR/drive_c/Spiele/Anstoss 2 Gold/@EXE@"'
        disable_runtime: true

    # Texts from A2G-Patch in RESDLL.dll, the event texts and the tips (src/a2texts.py, see README), after
    # the data set, which may bring files of its own, and after patch 1.01's data and the dialog styles:
    # typing errors (--typos, a bug fix in A2G-Patch) every time, then optionally one page each
    - execute:
        command: 'python3 "@PKG@/src/a2texts.py" --typos "$GAMEDIR/drive_c/Spiele/Anstoss 2 Gold"'
        disable_runtime: true

    - input_menu:
        description: 'Beträge in Euro statt DM anzeigen? Alle Beträge im Spiel, in Dialogen, Ereignissen und Tipps erscheinen dann mit € statt DM. Die Zahlen bleiben gleich: 1 DM wird zu 1 €. „DM“ als Abkürzung des defensiven Mittelfelds bleibt.'
        id: EURO
        options:
          - 'no': Original beibehalten
          - 'yes': Euro statt DM
        preselect: 'no'
    - execute:
        command: 'test "$INPUT_EURO" != yes || python3 "@PKG@/src/a2texts.py" --euro "$GAMEDIR/drive_c/Spiele/Anstoss 2 Gold"'
        disable_runtime: true

    - input_menu:
        description: 'Innenverteidiger (IV) statt Manndecker (MD)? Die Position heißt dann in Listen, Suchdialogen, der Nationalmannschaft und den Meldungen des Spiels Innenverteidiger.'
        id: CENTREBACK
        options:
          - 'no': Original beibehalten
          - 'yes': Innenverteidiger
        preselect: 'no'
    - execute:
        command: 'test "$INPUT_CENTREBACK" != yes || python3 "@PKG@/src/a2texts.py" --centre-back "$GAMEDIR/drive_c/Spiele/Anstoss 2 Gold"'
        disable_runtime: true

    - input_menu:
        description: 'Heutige Namen für Wettbewerbe, Ligen und Gruppen? UEFA-Cup, Cup der Pokalsieger, Weltcup und ECL-Cup statt UEFA-Pokal, Pokal der Pokalsieger, Weltpokal und UI-Cup; 1. und 2. Bundesliga, Regionalliga West, Championship, League One, Ligue 1 und 2; Gruppen A bis H statt 1 bis 8.'
        id: NAMES
        options:
          - 'no': Original beibehalten
          - 'yes': Heutige Namen
        preselect: 'no'
    - execute:
        command: 'test "$INPUT_NAMES" != yes || python3 "@PKG@/src/a2texts.py" --cups --leagues --groups "$GAMEDIR/drive_c/Spiele/Anstoss 2 Gold"'
        disable_runtime: true

    # Optional: the manager course quiz from A2G-Patch (src/a2quiz.py, see README): answers of today,
    # 150 new questions, both or neither
    - input_menu:
        description: 'Quiz der Managerfortbildung auffrischen? Mit heutigen Antworten sind 77 Fragen auf dem Stand von 2026: Meistertitel, Rekorde und Regeln von heute, Fragen zu Ämtern und Personen von damals nennen ihr Jahr, und vier Antworten, die schon 1998 falsch waren, sind berichtigt. Dazu oder statt dessen kommen 150 neue Fragen von der WM 1998 bis zur WM 2026.'
        id: QUIZ
        options:
          - original: Original beibehalten
          - answers: Antworten auf heutigen Stand bringen
          - both: Heutige Antworten und 150 neue Fragen
          - new: Originalfragen und 150 neue Fragen
        preselect: original
    - execute:
        command: 'test "$INPUT_QUIZ" = original || python3 "@PKG@/src/a2quiz.py" "$INPUT_QUIZ" "$GAMEDIR/drive_c/Spiele/Anstoss 2 Gold"'
        disable_runtime: true

    # Editor and, optionally, A2G-Trainer: entries in the application menu, started in this prefix
    # (src/a2run.sh). Not a Lutris file, since those cannot be optional.
    - input_menu:
        description: 'A2G-Trainer installieren? Er bearbeitet das laufende Spiel (Spieler, Vereine, Finanzen) und bekommt einen eigenen Eintrag im Anwendungsmenü.'
        id: TRAINER
        options:
          - none: Nicht installieren
          - download: Neueste Version von GitHub herunterladen
          - file: Aus einer lokalen Datei (zip oder exe)
        preselect: none
    - execute:
        command: 'python3 "@PKG@/src/a2extras.py" --slug @SLUG@ "$GAMEDIR" "$INPUT_TRAINER"'
        disable_runtime: true  # system tools (ImageMagick) with the system's libraries
